#include <stdio.h>
#include <math.h>

int main()
{
    float n, root;

    printf("Enter a number: ");
    scanf("%f", &n);

    if (n >= 0)
    {
        root = sqrt(n);
        printf("Square root = %.2f\n", root);
    }
    else
    {
        printf("Square root is not a real number\n");
    }

    return 0;
}
